{
    "name": "senior-backend-challenge",
    "version": "1.0.0",
    "description": "Senior Backend Engineer Interview Challenge - Routing and Evaluation Control Plane",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "install:all": "pnpm install",
        "build": "pnpm -r build",
        "start:legacy": "pnpm --filter legacy-app start:dev",
        "start:worker": "pnpm --filter worker-service start:dev",
        "start:all": "concurrently \"pnpm start:legacy\" \"pnpm start:worker\"",
        "test": "pnpm --filter @senior-challenge/shared-types build && pnpm -r test",
        "lint": "pnpm -r lint",
        "verify:challenge": "tsx scripts/verify-challenge.ts",
        "evaluate:replay": "tsx scripts/evaluate-replay.ts"
    },
    "devDependencies": {
        "@types/jest": "29.5.14",
        "@types/node": "^20.10.0",
        "concurrently": "^8.2.2",
        "jest": "29.7.0",
        "ts-jest": "29.2.5",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "packageManager": "pnpm@8.15.0"
}
